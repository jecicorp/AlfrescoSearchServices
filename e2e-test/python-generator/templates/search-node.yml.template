build:
  context: ./${SOLR_HOST}
environment:
  #Solr needs to know how to register itself with Alfresco
  SOLR_ALFRESCO_HOST: "alfresco"
  SOLR_ALFRESCO_PORT: "${ALFRESCO_PORT}"
  #Alfresco needs to know how to call solr
  SOLR_SOLR_HOST: "${SOLR_HOST}"
  SOLR_SOLR_PORT: "8983"
  #Create the default alfresco and archive cores
  SOLR_CREATE_ALFRESCO_DEFAULTS: "alfresco,archive"
  #Enable Spellcheck by setting to true
  ENABLE_SPELLCHECK: "${SEARCH_ENABLE_SPELLCHECK}"
  #Disable Cascade Tracking
  DISABLE_CASCADE_TRACKING: "${DISABLE_CASCADE_TRACKING}"
  #How Solr and the repository authenticate each other. The entrypoint
  #(solr-init-core.sh) reads this to rewrite solrcore.properties; without it the
  #template default (https) stands and Solr rejects every unauthenticated call.
  ALFRESCO_SECURE_COMMS: "${ALFRESCO_SECURE_COMMS}"
ports:
  - ${EXTERNAL_PORT}:8983 #Browser port
