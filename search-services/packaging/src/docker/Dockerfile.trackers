FROM eclipse-temurin:17-jre-alpine

LABEL org.opencontainers.image.title="Alfresco Indexing Trackers"
LABEL org.opencontainers.image.description="Alfresco content trackers - polls Repository and indexes via SolrJ"

RUN addgroup -g 33007 -S trackers && adduser -u 33007 -S -G trackers trackers

WORKDIR /app

COPY alfresco-indexing-trackers-*.jar /app/alfresco-indexing-trackers.jar

# Create model persistence directory
RUN mkdir -p /opt/solr/data/alfrescoModels

RUN chown -R trackers:trackers /app /opt/solr/data

USER trackers

EXPOSE 8085

HEALTHCHECK --interval=30s --timeout=10s --start-period=60s --retries=3 \
    CMD wget -q --spider http://localhost:8085/actuator/health || exit 1

ENTRYPOINT ["java", "-jar", "/app/alfresco-indexing-trackers.jar"]
