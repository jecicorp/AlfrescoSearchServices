FROM eclipse-temurin:21-jre-alpine

LABEL org.opencontainers.image.title="Pristy Indexing Trackers"
LABEL org.opencontainers.image.description="Pristy ECM indexing trackers - polls the repository and indexes via SolrJ"
LABEL org.opencontainers.image.vendor="Jeci SARL"
LABEL org.opencontainers.image.licenses="LGPL-3.0-or-later"
LABEL org.opencontainers.image.source="https://gitlab.com/pristy-oss/pristy-search-services"

RUN addgroup -g 33007 -S trackers && adduser -u 33007 -S -G trackers trackers \
    && apk add --no-cache curl

RUN sed -i 's|^mozilla/emSign_|!mozilla/emSign_|' /etc/ca-certificates.conf \
    && update-ca-certificates \
    && keytool -list -cacerts -storepass changeit \
        | grep -i '^cn_emsign_' \
        | sed -E 's/, [A-Z][a-z]{2} [0-9]{1,2}, [0-9]{4}, trustedCertEntry,.*$//' \
        | while read -r alias; do keytool -delete -cacerts -storepass changeit -alias "$alias" || exit 1; done \
    && printf '%s\n' \
        40F6AF0346A99AA1CD1D555A4E9CCE62C7F9634603EE406615833DC8C8D00367 \
        1AA0C2709E831BD6E3B5129A00BA41F7EEEF020872F1E6504BF0F6C3F24F3AF3 \
        125609AA301DA0A249B97A8239CB6A34216F44DCAC9F3954B14292F2E8C8608F \
        46CD083B47E80402028DF493960EA19C85FE851950D5165F1C7DA4FAA951E2F8 \
        86A1ECBA089C4A8D3BBE2734C612BA341D813E043CF9E8A862CD5C57A36BBE6B \
        BC4D809B15189D78DB3E1D8CF4F9726A795DA1643CA5F1358E1DDB0EDC0D7EB3 \
        >> "$JAVA_HOME/lib/security/blocked.certs"

WORKDIR /app

COPY pristy-indexing-trackers-*.jar /app/pristy-indexing-trackers.jar

# Create model persistence directory
RUN mkdir -p /opt/solr/data/alfrescoModels

RUN chown -R trackers:trackers /app /opt/solr/data

USER trackers

ENV JAVA_OPTS="-XX:MaxRAMPercentage=75"

EXPOSE 8085

HEALTHCHECK --interval=30s --timeout=10s --start-period=60s --retries=3 \
    CMD if [ "$TRACKER_SERVER_SSL_ENABLED" = "true" ]; then \
          curl -fsS -k -o /dev/null --cert-type P12 \
            --cert "$TRACKER_SERVER_SSL_KEY_STORE:$TRACKER_SERVER_SSL_KEY_STORE_PASSWORD" \
            https://localhost:8085/actuator/health; \
        else \
          curl -fsS -o /dev/null http://localhost:8085/actuator/health; \
        fi || exit 1

ENTRYPOINT ["sh", "-c", "exec java $JAVA_OPTS -jar /app/pristy-indexing-trackers.jar \"$@\"", "--"]
