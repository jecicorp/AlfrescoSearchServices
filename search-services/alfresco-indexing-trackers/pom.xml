<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>fr.jeci.alfresco</groupId>
        <artifactId>alfresco-solr-search-parent</artifactId>
        <version>2.99.0-SNAPSHOT</version>
    </parent>

    <artifactId>alfresco-indexing-trackers</artifactId>
    <name>Alfresco Indexing Trackers</name>
    <description>Alfresco content trackers - polls Alfresco Repository and indexes into search engine via InformationServer interface</description>

    <properties>
        <spring-boot.version>3.4.1</spring-boot.version>
    </properties>

    <dependencies>
        <!-- Spring Boot -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter</artifactId>
            <version>${spring-boot.version}</version>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-actuator</artifactId>
            <version>${spring-boot.version}</version>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-web</artifactId>
            <version>${spring-boot.version}</version>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-configuration-processor</artifactId>
            <version>${spring-boot.version}</version>
            <optional>true</optional>
        </dependency>
        <!-- Enforce SLF4J 2.x: overrides 1.7.x pulled by alfresco-data-model transitive deps -->
        <dependency>
            <groupId>org.slf4j</groupId>
            <artifactId>slf4j-api</artifactId>
            <version>2.0.16</version>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <version>${spring-boot.version}</version>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>fr.jeci.alfresco</groupId>
            <artifactId>alfresco-solrclient-lib</artifactId>
            <version>${project.version}</version>
            <exclusions>
                <!-- Exclude SLF4J 1.7.x binding: Spring Boot 3.4 uses SLF4J 2.x + Logback -->
                <exclusion>
                    <groupId>org.slf4j</groupId>
                    <artifactId>slf4j-reload4j</artifactId>
                </exclusion>
                <exclusion>
                    <groupId>ch.qos.reload4j</groupId>
                    <artifactId>reload4j</artifactId>
                </exclusion>
            </exclusions>
        </dependency>
        <dependency>
            <groupId>org.quartz-scheduler</groupId>
            <artifactId>quartz</artifactId>
            <version>2.3.2</version>
            <exclusions>
                <!-- Exclude SLF4J 1.7.x: Spring Boot 3.4 brings SLF4J 2.x via Logback -->
                <exclusion>
                    <groupId>org.slf4j</groupId>
                    <artifactId>slf4j-api</artifactId>
                </exclusion>
            </exclusions>
        </dependency>
        <dependency>
            <groupId>com.google.guava</groupId>
            <artifactId>guava</artifactId>
        </dependency>
        <dependency>
            <groupId>commons-codec</groupId>
            <artifactId>commons-codec</artifactId>
        </dependency>
        <dependency>
            <groupId>org.apache.solr</groupId>
            <artifactId>solr-solrj</artifactId>
            <version>${solr.base.version}</version>
            <exclusions>
                <exclusion>
                    <groupId>org.slf4j</groupId>
                    <artifactId>slf4j-api</artifactId>
                </exclusion>
                <!-- Exclude Jetty HTTP client (used by Http2SolrClient, not needed).
                     Conflicts with Spring Boot 3.4 which expects Jetty 12+ APIs. -->
                <exclusion>
                    <groupId>org.eclipse.jetty</groupId>
                    <artifactId>*</artifactId>
                </exclusion>
                <exclusion>
                    <groupId>org.eclipse.jetty.http2</groupId>
                    <artifactId>*</artifactId>
                </exclusion>
            </exclusions>
        </dependency>
        <!-- Override Gson version: Spring Boot 3.4 requires Gson 2.11+ (Strictness class) -->
        <dependency>
            <groupId>com.google.code.gson</groupId>
            <artifactId>gson</artifactId>
            <version>2.11.0</version>
        </dependency>

        <!-- Test dependencies -->
        <dependency>
            <groupId>junit</groupId>
            <artifactId>junit</artifactId>
            <scope>test</scope>
        </dependency>
        <!-- JUnit Vintage engine to run JUnit 4 tests on JUnit 5 platform -->
        <dependency>
            <groupId>org.junit.vintage</groupId>
            <artifactId>junit-vintage-engine</artifactId>
            <version>5.11.4</version>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.mockito</groupId>
            <artifactId>mockito-core</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
                <version>${spring-boot.version}</version>
                <configuration>
                    <mainClass>org.alfresco.indexing.TrackerApplication</mainClass>
                </configuration>
                <executions>
                    <execution>
                        <goals>
                            <goal>repackage</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>
            <plugin>
                <groupId>org.codehaus.mojo</groupId>
                <artifactId>license-maven-plugin</artifactId>
                <executions>
                    <!-- Exclude Jeci-authored files from the inherited Alfresco (community) header check -->
                    <execution>
                        <id>check-licenses</id>
                        <configuration>
                            <excludes combine.children="append">
                            <exclude>**/org/alfresco/indexing/TrackerApplication.java</exclude>
                            <exclude>**/org/alfresco/indexing/TrackerApplicationTest.java</exclude>
                            <exclude>**/org/alfresco/indexing/admin/AdminController.java</exclude>
                            <exclude>**/org/alfresco/indexing/admin/AdminService.java</exclude>
                            <exclude>**/org/alfresco/indexing/admin/SolrCompatAdminController.java</exclude>
                            <exclude>**/org/alfresco/indexing/config/RepairReportEndpoint.java</exclude>
                            <exclude>**/org/alfresco/indexing/config/RepositoryClientConfig.java</exclude>
                            <exclude>**/org/alfresco/indexing/config/SolrJConfig.java</exclude>
                            <exclude>**/org/alfresco/indexing/config/FileKeyResourceLoader.java</exclude>
                            <exclude>**/org/alfresco/indexing/config/FileKeyResourceLoaderTest.java</exclude>
                            <exclude>**/org/alfresco/indexing/config/TrackerBootstrap.java</exclude>
                            <exclude>**/org/alfresco/indexing/config/TrackerBootstrapTest.java</exclude>
                            <exclude>**/org/alfresco/indexing/config/TrackerProperties.java</exclude>
                            <exclude>**/org/alfresco/indexing/config/TrackerPropertiesSslTest.java</exclude>
                            <exclude>**/org/alfresco/indexing/health/RepositoryHealthIndicator.java</exclude>
                            <exclude>**/org/alfresco/indexing/health/SolrHealthIndicator.java</exclude>
                            <exclude>**/org/alfresco/indexing/server/solrj/JavaBitSetAdapter.java</exclude>
                            <exclude>**/org/alfresco/indexing/server/solrj/JavaBitSetAdapterTest.java</exclude>
                            <exclude>**/org/alfresco/indexing/server/solrj/LinkedHashMapOrderedMap.java</exclude>
                            <exclude>**/org/alfresco/indexing/server/solrj/LocalDictionaryService.java</exclude>
                            <exclude>**/org/alfresco/indexing/server/solrj/PropertyFieldMapper.java</exclude>
                            <exclude>**/org/alfresco/indexing/server/solrj/PropertyFieldMapperTest.java</exclude>
                            <exclude>**/org/alfresco/indexing/server/solrj/SolrDocumentMapper.java</exclude>
                            <exclude>**/org/alfresco/indexing/server/solrj/SolrDocumentMapperTest.java</exclude>
                            <exclude>**/org/alfresco/indexing/server/solrj/SolrJCommitService.java</exclude>
                            <exclude>**/org/alfresco/indexing/server/solrj/SolrJCommitServiceTest.java</exclude>
                            <exclude>**/org/alfresco/indexing/server/solrj/SolrJIndexingService.java</exclude>
                            <exclude>**/org/alfresco/indexing/server/solrj/SolrJIndexingServiceTest.java</exclude>
                            <exclude>**/org/alfresco/indexing/server/solrj/SolrJInformationServer.java</exclude>
                            <exclude>**/org/alfresco/indexing/server/solrj/SolrJInformationServerCascadeTest.java</exclude>
                            <exclude>**/org/alfresco/indexing/server/solrj/SolrJModelService.java</exclude>
                            <exclude>**/org/alfresco/indexing/server/solrj/SolrJModelServiceTest.java</exclude>
                            <exclude>**/org/alfresco/indexing/server/solrj/SolrJQueryService.java</exclude>
                            <exclude>**/org/alfresco/indexing/server/solrj/SolrJQueryServiceTest.java</exclude>
                            <exclude>**/org/alfresco/indexing/tracker/DataModelCallback.java</exclude>
                            <exclude>**/org/alfresco/indexing/tracker/repair/EmptyNodeStrategy.java</exclude>
                            <exclude>**/org/alfresco/indexing/tracker/repair/EmptyNodeStrategyTest.java</exclude>
                            <exclude>**/org/alfresco/indexing/tracker/repair/RepairReport.java</exclude>
                            <exclude>**/org/alfresco/indexing/tracker/repair/RepairReportTest.java</exclude>
                            <exclude>**/org/alfresco/indexing/tracker/repair/RepairResult.java</exclude>
                            <exclude>**/org/alfresco/indexing/tracker/repair/RepairTracker.java</exclude>
                            <exclude>**/org/alfresco/indexing/tracker/repair/RepairTrackerTest.java</exclude>
                            <exclude>**/org/alfresco/indexing/tracker/repair/UnresolvedModelStrategy.java</exclude>
                            <exclude>**/org/alfresco/indexing/tracker/repair/UnresolvedModelStrategyTest.java</exclude>
                            </excludes>
                        </configuration>
                    </execution>
                    <!-- Check Jeci-authored files against the Pristy LGPL header -->
                    <execution>
                        <id>check-licenses-pristy</id>
                        <phase>compile</phase>
                        <goals>
                            <goal>update-file-header</goal>
                        </goals>
                        <configuration>
                            <licenseName>pristy_lgpl_v3</licenseName>
                            <licenseResolver>file://${maven.multiModuleProjectDirectory}/license-headers</licenseResolver>
                            <organizationName>Jeci SARL - https://jeci.fr</organizationName>
                            <inceptionYear>2026</inceptionYear>
                            <addJavaLicenseAfterPackage>false</addJavaLicenseAfterPackage>
                            <canUpdateCopyright>${license.update.copyright}</canUpdateCopyright>
                            <failOnMissingHeader>true</failOnMissingHeader>
                            <failOnNotUptodateHeader>true</failOnNotUptodateHeader>
                            <dryRun>${license.update.dryrun}</dryRun>
                            <roots>
                                <root>src</root>
                            </roots>
                            <includes>
                            <include>**/org/alfresco/indexing/TrackerApplication.java</include>
                            <include>**/org/alfresco/indexing/TrackerApplicationTest.java</include>
                            <include>**/org/alfresco/indexing/admin/AdminController.java</include>
                            <include>**/org/alfresco/indexing/admin/AdminService.java</include>
                            <include>**/org/alfresco/indexing/admin/SolrCompatAdminController.java</include>
                            <include>**/org/alfresco/indexing/config/RepairReportEndpoint.java</include>
                            <include>**/org/alfresco/indexing/config/RepositoryClientConfig.java</include>
                            <include>**/org/alfresco/indexing/config/SolrJConfig.java</include>
                            <include>**/org/alfresco/indexing/config/FileKeyResourceLoader.java</include>
                            <include>**/org/alfresco/indexing/config/FileKeyResourceLoaderTest.java</include>
                            <include>**/org/alfresco/indexing/config/TrackerBootstrap.java</include>
                            <include>**/org/alfresco/indexing/config/TrackerBootstrapTest.java</include>
                            <include>**/org/alfresco/indexing/config/TrackerProperties.java</include>
                            <include>**/org/alfresco/indexing/config/TrackerPropertiesSslTest.java</include>
                            <include>**/org/alfresco/indexing/health/RepositoryHealthIndicator.java</include>
                            <include>**/org/alfresco/indexing/health/SolrHealthIndicator.java</include>
                            <include>**/org/alfresco/indexing/server/solrj/JavaBitSetAdapter.java</include>
                            <include>**/org/alfresco/indexing/server/solrj/JavaBitSetAdapterTest.java</include>
                            <include>**/org/alfresco/indexing/server/solrj/LinkedHashMapOrderedMap.java</include>
                            <include>**/org/alfresco/indexing/server/solrj/LocalDictionaryService.java</include>
                            <include>**/org/alfresco/indexing/server/solrj/PropertyFieldMapper.java</include>
                            <include>**/org/alfresco/indexing/server/solrj/PropertyFieldMapperTest.java</include>
                            <include>**/org/alfresco/indexing/server/solrj/SolrDocumentMapper.java</include>
                            <include>**/org/alfresco/indexing/server/solrj/SolrDocumentMapperTest.java</include>
                            <include>**/org/alfresco/indexing/server/solrj/SolrJCommitService.java</include>
                            <include>**/org/alfresco/indexing/server/solrj/SolrJCommitServiceTest.java</include>
                            <include>**/org/alfresco/indexing/server/solrj/SolrJIndexingService.java</include>
                            <include>**/org/alfresco/indexing/server/solrj/SolrJIndexingServiceTest.java</include>
                            <include>**/org/alfresco/indexing/server/solrj/SolrJInformationServer.java</include>
                            <include>**/org/alfresco/indexing/server/solrj/SolrJInformationServerCascadeTest.java</include>
                            <include>**/org/alfresco/indexing/server/solrj/SolrJModelService.java</include>
                            <include>**/org/alfresco/indexing/server/solrj/SolrJModelServiceTest.java</include>
                            <include>**/org/alfresco/indexing/server/solrj/SolrJQueryService.java</include>
                            <include>**/org/alfresco/indexing/server/solrj/SolrJQueryServiceTest.java</include>
                            <include>**/org/alfresco/indexing/tracker/DataModelCallback.java</include>
                            <include>**/org/alfresco/indexing/tracker/repair/EmptyNodeStrategy.java</include>
                            <include>**/org/alfresco/indexing/tracker/repair/EmptyNodeStrategyTest.java</include>
                            <include>**/org/alfresco/indexing/tracker/repair/RepairReport.java</include>
                            <include>**/org/alfresco/indexing/tracker/repair/RepairReportTest.java</include>
                            <include>**/org/alfresco/indexing/tracker/repair/RepairResult.java</include>
                            <include>**/org/alfresco/indexing/tracker/repair/RepairTracker.java</include>
                            <include>**/org/alfresco/indexing/tracker/repair/RepairTrackerTest.java</include>
                            <include>**/org/alfresco/indexing/tracker/repair/UnresolvedModelStrategy.java</include>
                            <include>**/org/alfresco/indexing/tracker/repair/UnresolvedModelStrategyTest.java</include>
                            </includes>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>

</project>
