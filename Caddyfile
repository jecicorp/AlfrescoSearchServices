:80 {
	log {
		format console
		output stdout
	}

	redir /alfresco     /alfresco/
	redir /api-explorer /api-explorer/

	reverse_proxy /alfresco/* alfresco:8080
	reverse_proxy /api-explorer/* alfresco:8080

	redir /        /portail/
	redir /portail /portail/
	redir /espaces /espaces/

	reverse_proxy /portail/* pristy-portail:80
	reverse_proxy /espaces/* pristy-espaces:80
}

# Solr admin UI with automatic secret header injection.
# NOTE: this block does NOT work in secureComms=https (mTLS) mode.
# Solr's Jetty is configured with SOLR_SSL_NEED_CLIENT_AUTH=true, so every
# inbound connection — including this Caddy proxy — must present a valid
# client certificate.  In https mode, either disable this block and access
# the Solr UI directly (with a client cert installed in your browser), or
# add a "tls_client_auth" directive pointing to a certificate signed by the
# same CA (see docs/secure-comms-https.md §6).
:8984 {
	reverse_proxy solr:8983 {
		header_up X-Alfresco-Search-Secret "secret"
	}
}
